# Only the web source and its local assets enter the build context.
*
!installed-requirements.txt
!*.py
!templates/
!templates/**
!static/
!static/**
!vendor0184/
!vendor0184/**

# Keep local configuration, credentials, data, recordings and large artifacts out.
**/.env
**/.env.*
**/*secret*
**/*credential*
**/*.key
**/*.pem
**/*.pgpass
**/*.wav
**/*.mp3
**/*.mp4
**/*.m4a
**/*.flac
**/*.ogg
**/models/
**/models/**
**/response-models/
**/response-models/**
**/venv/
**/venv/**
**/.venv/
**/.venv/**
**/__pycache__/
**/__pycache__/**
**/*.pyc
**/*.bak
**/*.backup
**/*~
config/
config/**
data/
data/**
