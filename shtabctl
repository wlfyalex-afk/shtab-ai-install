#!/bin/bash
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo 'Run with sudo'; exit 1; }
cd /opt/shtab-ai
dc() { bash scripts/dc.sh "$@"; }
action=${1:-}
if [[ -z $action ]]; then
    if [[ -t 0 ]]; then action=menu; else action=status; fi
fi
case $action in
menu) exec bash scripts/menu.sh ;;
backup|backups|restore|reset-db) python3 scripts/admin.py "$action" "${@:2}" ;;
uninstall) bash uninstall.sh "${2:---keep-data}" ;;
progress) python3 scripts/install-progress.py "${@:2}" ;;
monitor) exec bash scripts/monitor-install.sh "${@:2}" ;;
status)
    cat /var/lib/shtab-ai/status 2>/dev/null || true
    systemctl show shtab-ai-install.service -p ActiveState -p SubState -p Result
    if command -v docker >/dev/null; then dc ps; fi
    ;;
https-check) bash scripts/check-https.sh ;;
vpn)
    [[ $(cat access-mode 2>/dev/null || true) == lan ]] || { echo 'VPN доступ настраивается в режиме локальной сети.'; exit 1; }
    if [[ $# -gt 1 ]]; then
        python3 scripts/network-config.py set-vpn /opt/shtab-ai "${@:2}"
        bash scripts/network-firewall.sh apply
    else
        python3 scripts/network-config.py list /opt/shtab-ai
    fi
    ;;
certificate)
    owned_ca=false
    system_ca=/usr/local/share/ca-certificates/shtab-ai.crt
    if [[ -f $system_ca && -f shtab-ai-root.crt ]] && cmp -s "$system_ca" shtab-ai-root.crt; then owned_ca=true; fi
    install -m 0644 tls-data/caddy/pki/authorities/local/root.crt shtab-ai-root.crt
    if $owned_ca; then install -m 0644 shtab-ai-root.crt "$system_ca"; update-ca-certificates; fi
    openssl x509 -in shtab-ai-root.crt -noout -fingerprint -sha256
    echo "Public root certificate: /opt/shtab-ai/shtab-ai-root.crt"
    if [[ -n ${SUDO_USER:-} && $SUDO_USER != root ]]; then
        python3 - "$SUDO_USER" <<'PYCODE'
from pathlib import Path
import pwd, runpy, sys
runpy.run_path('scripts/create-desktop-shortcut.py')['export_certificate'](Path.cwd(), pwd.getpwnam(sys.argv[1]))
PYCODE
    fi
    ;;
diagnose) bash scripts/diagnose.sh ;;
support) python3 scripts/support-report.py ;;
logs) journalctl -u shtab-ai-install -n 100 --no-pager ;;
resume)
    bash scripts/resume-install.sh
    exec bash scripts/finish-install.sh --wait
    ;;
finish) exec bash scripts/finish-install.sh ;;
bootstrap)
    [[ $(cat /var/lib/shtab-ai/status) == READY_FOR_ADMIN ]] || { echo 'Wait for READY_FOR_ADMIN'; exit 1; }
    dc exec web python bootstrap.py
    ;;
check)
    dc exec -T web python manage.py check
    dc exec -T meeting-worker python meeting_worker.py check --load-model
    dc exec -T llm-worker python llm_worker013.py check
    dc exec -T brief-worker python brief_worker017.py check
    dc exec -T web python check0183.py
    dc exec -T web python check01845.py
    ;;
stop) dc stop proxy web meeting-worker llm-worker brief-worker ollama ;;
start)
    if ! grep -q '^SHTAB_OLLAMA_ENDPOINT=' .env; then dc up -d --wait --wait-timeout 240 ollama; fi
    dc up -d --wait --wait-timeout 240 web meeting-worker llm-worker brief-worker proxy ;;
*) echo 'Commands: menu, vpn, backup, backups, restore, reset-db, uninstall, certificate, https-check, status, progress, monitor, diagnose, support, logs, resume, finish, bootstrap, check, stop, start'; exit 2 ;;
esac
